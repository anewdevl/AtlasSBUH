# Optional. The free Overpass.ch plan needs an API key. Create one at https://overpass.ch/.
# Set these values in the existing root .env; never put a real key in this file or Git.
# ATLAS_OVERPASS_ENDPOINT=https://api.overpass.ch/v1/interpreter
# ATLAS_OVERPASS_API_KEY=your_key_here

# Optional NVIDIA NIM category suggestions. The key is used only by the server.
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional research. NVIDIA plans/extracts/synthesizes/verifies; Tavily retrieves web content.
# TAVILY_API_KEY=your_tavily_api_key_here
# ATLAS_RESEARCH_SOURCES=6
# Research uses NVIDIA Lightning with thinking disabled; no new key needed.
# ATLAS_RESEARCH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional alternative: ATLAS_RESEARCH_MODEL=openai/gpt-oss-20b
# Python judgment/review default to the same model as extraction.
# Optional slower reasoning model: ATLAS_RESEARCH_JUDGMENT_MODEL=openai/gpt-oss-20b
# ATLAS_RESEARCH_TOKENS=3000
# ATLAS_RESEARCH_TIMEOUT_MS=100000
# ATLAS_RESEARCH_CONCURRENCY=2
# Four-role research pipeline: shared HTTP-call budget, including page reading and evidence review.
# ATLAS_RESEARCH_REQUESTS=12

# Optional Photon-compatible location search endpoint. Default is the public demo service.
# Explicit searches only, cached and rate-limited; no additional API key required.
# ATLAS_GEOCODER_ENDPOINT=https://photon.komoot.io/api/
# If Photon fails, location search tries mapped landmark names in the city envelope.
# Internal service configuration (defaults shown):
# ATLAS_API_PORT=8000
# ATLAS_BACKEND_URL=http://127.0.0.1:8000
# Vercel keeps TypeScript APIs unless Python hosting is explicitly enabled.
# Set this only after configuring a deployed HTTPS ATLAS_BACKEND_URL on Vercel.
# ATLAS_USE_PYTHON_BACKEND=1
# ATLAS_PYTHON=python

# No-key public alternatives (best effort):
# ATLAS_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# ATLAS_OVERPASS_ENDPOINT=https://maps.mail.ru/osm/tools/overpass/api/interpreter
